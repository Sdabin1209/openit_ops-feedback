{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GateSubmission",
  "description": "게이트에 판정을 요청한 기록. 판정은 비동기이며 결과는 GateDecision(submission_id로 연결)으로 조회한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pipeline_schema_version",
    "submission_id",
    "submitted_at",
    "submitted_by_role",
    "subject"
  ],
  "properties": {
    "pipeline_schema_version": {
      "$ref": "_common.schema.json#/$defs/PipelineSchemaVersion"
    },
    "submission_id": {
      "$ref": "_common.schema.json#/$defs/Id"
    },
    "submitted_at": {
      "$ref": "_common.schema.json#/$defs/Timestamp"
    },
    "submitted_by_role": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_set",
        "lora_a",
        "lora_b"
      ],
      "properties": {
        "question_set": {
          "$ref": "_common.schema.json#/$defs/ArtifactRef"
        },
        "lora_a": {
          "$ref": "_common.schema.json#/$defs/ArtifactRef"
        },
        "lora_b": {
          "$ref": "_common.schema.json#/$defs/ArtifactRef"
        }
      }
    },
    "ext": {
      "type": "object",
      "description": "영역이 계약을 바꾸지 않고 덧붙이는 부가 정보. 키는 영역 이름(예: 'model-lab')이고 값은 그 영역이 정한다. 다른 영역은 이해하지 못해도 보존하고 전달해야 하며, 판단에 쓰지 않는다. 여러 영역이 필요로 하게 되면 정식 필드로 올린다."
    }
  }
}
