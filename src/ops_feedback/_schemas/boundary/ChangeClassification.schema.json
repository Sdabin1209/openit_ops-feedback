{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeClassification",
  "description": "문항 세트의 한 버전 변경이 무엇을 바꿨는지와 필요한 후속 작업. 문구 / 선택지·단위 / 슬롯 / 분기의 4종으로 시작한다(D17).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pipeline_schema_version",
    "classification_id",
    "to",
    "change_kinds",
    "affected_slots",
    "follow_ups",
    "created_at"
  ],
  "properties": {
    "pipeline_schema_version": {
      "$ref": "_common.schema.json#/$defs/PipelineSchemaVersion"
    },
    "classification_id": {
      "$ref": "_common.schema.json#/$defs/Id"
    },
    "to": {
      "$ref": "_common.schema.json#/$defs/ArtifactRef"
    },
    "from": {
      "$ref": "_common.schema.json#/$defs/ArtifactRef"
    },
    "change_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "TEXT",
          "CHOICE_UNIT",
          "SLOT",
          "BRANCH"
        ]
      }
    },
    "affected_slots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "문진 스키마 SlotRef를 문자열로 직렬화한 값"
    },
    "follow_ups": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "REGENERATE_SAMPLES",
          "REEVALUATE_MODEL",
          "CLINICAL_REVIEW"
        ]
      },
      "description": "비어 있으면 게이트 검사만 필요하다"
    },
    "created_at": {
      "$ref": "_common.schema.json#/$defs/Timestamp"
    },
    "ext": {
      "type": "object",
      "description": "영역이 계약을 바꾸지 않고 덧붙이는 부가 정보. 키는 영역 이름(예: 'model-lab')이고 값은 그 영역이 정한다. 다른 영역은 이해하지 못해도 보존하고 전달해야 하며, 판단에 쓰지 않는다. 여러 영역이 필요로 하게 되면 정식 필드로 올린다."
    }
  }
}
