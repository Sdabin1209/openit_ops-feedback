{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.example/ops-feedback/server-env.schema.json",
  "title": "OpsFeedbackServerEnvAndBuildArgs",
  "description": "ingest-api 서버·admin·잡이 읽는 환경 변수와 Dockerfile ARG. 만드는 쪽: deploy(compose). 읽는 쪽: ops-feedback. 환경 변수는 문자열 맵으로 검증한다. 모르는 OPS_ 변수와 모르는 ARG는 거부한다(오타로 보관 경고·검토자 신원 필수 같은 설정이 조용히 꺼지는 것을 막는다). OPS_ 아닌 변수(PATH 등)는 이 스키마의 대상이 아니다: 검증할 때 OPS_ 접두 변수만 넣는다. 비밀(토큰, DB URL, salt)은 값 변수 대신 <이름>_FILE(경로)을 쓴다(D84); 값 변수(OPS_INGEST_TOKEN 등)는 개발·시험용이다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["env"],
  "properties": {
    "env": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "OPS_INGEST_TOKEN_FILE": {"$ref": "#/$defs/Path", "description": "수집 쓰기 토큰 파일. 서버 필수(이것 또는 개발용 OPS_INGEST_TOKEN)"},
        "OPS_INGEST_TOKEN": {"type": "string", "minLength": 1, "description": "개발·시험용"},
        "OPS_READ_TOKENS_FILE": {"$ref": "#/$defs/Path"}, "OPS_READ_TOKENS": {"$ref": "#/$defs/RoleTokens"},
        "OPS_REVIEW_TOKENS_FILE": {"$ref": "#/$defs/Path"}, "OPS_REVIEW_TOKENS": {"$ref": "#/$defs/RoleTokens"},
        "OPS_LOG_DB": {"type": "string", "minLength": 1, "description": "SQLite 경로(기본 /data/log.db)"},
        "OPS_FAILURE_DB": {"type": "string", "minLength": 1, "description": "SQLite 경로. 없고 FAILURE_DATABASE_URL도 없으면 읽기·검토 면이 꺼진다"},
        "OPS_LOG_DATABASE_URL_FILE": {"$ref": "#/$defs/Path"}, "OPS_LOG_DATABASE_URL": {"type": "string", "pattern": "^postgres(ql)?://"},
        "OPS_FAILURE_DATABASE_URL_FILE": {"$ref": "#/$defs/Path"}, "OPS_FAILURE_DATABASE_URL": {"type": "string", "pattern": "^postgres(ql)?://"},
        "OPS_DEID_SALT_FILE": {"$ref": "#/$defs/Path", "description": "잡과 admin이 읽는다(서버는 읽지 않는다). 이름은 잡 설정 deid.salt_env로 바뀔 수 있다"},
        "OPS_DEID_SALT": {"type": "string", "minLength": 1, "description": "개발·시험용"},
        "OPS_PORT": {"$ref": "#/$defs/IntStr", "description": "기본 8080"},
        "OPS_MAX_CONNECTIONS": {"$ref": "#/$defs/IntStr", "description": "1 이상, 기본 64"},
        "OPS_READYZ_CACHE_SECONDS": {"$ref": "#/$defs/NumStr", "description": "0 이상, 기본 1.5"},
        "OPS_RAW_RETENTION_DAYS": {"type": "string", "pattern": "^\\s*\\S.*$", "description": "선언일 뿐 서버가 지우지 않는다. 비어 있으면 /readyz warnings에 RAW_RETENTION_UNSET"},
        "OPS_REVIEW_REQUIRE_USER": {"type": "string", "description": "0|false|no(대소문자 무시)면 끔. 그 밖은 켬. 기본 켬"},
        "OPS_DB_CONNECT_TIMEOUT": {"$ref": "#/$defs/SecondsStr"}, "OPS_DB_STATEMENT_TIMEOUT": {"$ref": "#/$defs/SecondsStr"},
        "OPS_DB_PROBE_TIMEOUT": {"$ref": "#/$defs/SecondsStr"}, "OPS_DB_DDL_TIMEOUT": {"$ref": "#/$defs/SecondsStr"},
        "OPS_DB_SCHEMA": {"enum": ["apply", "verify"], "description": "기본 apply. verify면 앱 계정에 DDL 권한이 필요 없다"}
      }
    },
    "build_args": {
      "type": "object",
      "additionalProperties": false,
      "description": "Dockerfile ARG. 라벨 io.openit.* (D50)에 기록된다. 이미지 빌드 전에 build/wheels가 있어야 한다(scripts/build_wheels.sh).",
      "properties": {
        "COMMIT": {"type": "string", "minLength": 1}, "CONTRACTS_VERSION": {"type": "string", "minLength": 1},
        "SURVEY_SCHEMA_VERSION": {"type": "string", "minLength": 1}, "TURN_ENGINE_VERSION": {"type": "string", "minLength": 1},
        "MODEL_RUNTIME_VERSION": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "Path": {"type": "string", "pattern": "^/.+"},
    "RoleTokens": {"type": "string", "description": "역할=토큰,역할=토큰 (개발용 값 변수)", "pattern": "^[^=,]+=[^,]+(,[^=,]+=[^,]+)*$"},
    "IntStr": {"type": "string", "pattern": "^[0-9]+$"},
    "NumStr": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "SecondsStr": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$", "description": "0 초과 3600 이하(pgbase.py _setting). 이 패턴은 모양만 본다"}
  }
}
