{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaseBuildResult",
  "description": "조립 결과: FailureCase(version 1)와 저장할 비식별 trace와 그 참조.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "case": {
      "$ref": "../boundary/FailureCase.schema.json"
    },
    "trace_ref": {
      "$ref": "../boundary/_common.schema.json#/$defs/Id"
    },
    "trace": {
      "$ref": "../boundary/OpsFeedbackDeidentifiedTrace.schema.json"
    },
    "review_trace": {
      "$ref": "../boundary/OpsFeedbackReviewTrace.schema.json",
      "description": "정책 deid.review_utterance.keep=true일 때만 있다: 발화 두 칸만 원문인 검토 사본(reviewer 역할 전용 경로로만 나간다, ADR 0030)"
    }
  },
  "required": [
    "case",
    "trace_ref",
    "trace"
  ]
}
