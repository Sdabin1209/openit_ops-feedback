{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RollbackAssessRequest",
  "description": "롤백 판단 입력: 현재 릴리스의 창 안 전체 턴 수와 사례 요약과 기준(사용자 결정, 기본값 없음).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "now": {
      "$ref": "../boundary/_common.schema.json#/$defs/Timestamp"
    },
    "release_id": {
      "$ref": "../boundary/_common.schema.json#/$defs/Id"
    },
    "total_turns": {
      "type": "integer",
      "minimum": 0
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "CaseSummary.schema.json"
      }
    },
    "policy": {
      "$ref": "../boundary/OpsFeedbackJobConfig.schema.json#/properties/rollback",
      "properties": {
        "counted_review_statuses": {
          "items": {
            "const": "CONFIRMED"
          }
        }
      },
      "description": "롤백 기준(계약) + 영역 조건: 실패율에는 사람이 CONFIRMED로 검토한 사례만 센다. 자동 탐지만 거친 사례(PENDING)를 세면 수집 토큰만 가진 쪽이 위조 Trace로 롤백 요청을 만들 수 있다(L07, ADR 0029)."
    }
  },
  "required": [
    "now",
    "release_id",
    "total_turns",
    "cases",
    "policy"
  ]
}
