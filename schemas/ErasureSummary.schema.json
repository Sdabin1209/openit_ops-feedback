{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ErasureSummary",
  "description": "관리 도구가 출력하는 건수 요약. found=false면 salt·정책 확인을 알리는 note가 따른다. 세션 ID는 싣지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "raw_rows": {
      "type": "integer",
      "minimum": 0
    },
    "cases": {
      "type": "integer",
      "minimum": 0
    },
    "traces": {
      "type": "integer",
      "minimum": 0
    },
    "dry_run": {
      "type": "boolean"
    },
    "found": {
      "type": "boolean"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "raw_rows",
    "cases",
    "traces",
    "dry_run",
    "found"
  ]
}
