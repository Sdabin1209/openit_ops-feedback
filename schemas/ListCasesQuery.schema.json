{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ListCasesQuery",
  "description": "읽기 면(GET /v1/cases)의 쿼리 문자열 값(전부 문자열). limit은 1~500(MAX_LIMIT, 한 번에 올리는 양을 묶는 임의 상한, ADR 0008).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "limit": {
      "type": "string",
      "pattern": "^([1-9]|[1-9][0-9]|[1-4][0-9]{2}|500)$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "latest_only": {
      "enum": [
        "true",
        "false"
      ]
    },
    "updated_since": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "review_status": {
      "enum": [
        "PENDING",
        "CONFIRMED",
        "DISMISSED"
      ]
    },
    "failure_type": {
      "type": "string",
      "minLength": 1
    },
    "source_release_id": {
      "type": "string",
      "minLength": 1
    },
    "cursor": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": []
}
