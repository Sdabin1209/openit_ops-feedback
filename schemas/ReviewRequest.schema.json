{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewRequest",
  "description": "검토 적용 입력: 최신 version의 사례와 결정.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "current": {
      "$ref": "../boundary/FailureCase.schema.json"
    },
    "decision": {
      "$ref": "ReviewDecision.schema.json"
    },
    "now": {
      "$ref": "../boundary/_common.schema.json#/$defs/Timestamp"
    },
    "preserved_utterances": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "이 사례의 검토 사본에 보존된 환자 발화 원문(없으면 생략). reviewed_input이 읽기 역할 전체가 읽는 FailureCase에 실리므로, 그 안에 이 원문이 그대로 들어 있으면 거부하는 데 쓴다(ADR 0030). 값은 오류에 싣지 않는다."
    }
  },
  "required": [
    "current",
    "decision",
    "now"
  ]
}
