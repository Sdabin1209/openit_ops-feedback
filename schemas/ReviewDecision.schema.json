{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewDecision",
  "description": "검토 결정. 상태·정답·종류의 조건부 필수와 정답 형식(종류별 계약 타입)을 모두 여기서 정한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_status",
    "reviewer_role"
  ],
  "properties": {
    "review_status": {
      "enum": [
        "CONFIRMED",
        "DISMISSED",
        "PENDING"
      ]
    },
    "reviewer_role": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_by": {
      "$ref": "../boundary/_common.schema.json#/$defs/Id",
      "description": "검토자 식별자(X-Openit-User 값). 요청에서 온 값이라 계약 Id 형식이 아니면 입구에서 400으로 거부한다(입력 잘못, 재시도 불가)."
    },
    "base_version": {
      "type": "integer",
      "minimum": 1
    },
    "failure_type": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string"
    },
    "expected_kind": {
      "enum": [
        "LORA_A",
        "LORA_B"
      ]
    },
    "expected": {
      "$ref": "#/$defs/Bounded"
    },
    "reviewed_input": {
      "$ref": "#/$defs/Bounded"
    }
  },
  "dependentRequired": {
    "expected": [
      "expected_kind"
    ],
    "reviewed_input": [
      "expected_kind"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "enum": [
              "DISMISSED",
              "PENDING"
            ]
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "expected"
              ]
            },
            {
              "required": [
                "reviewed_input"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "expected_kind"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "expected"
            ]
          },
          {
            "required": [
              "reviewed_input"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "expected_kind"
        ],
        "properties": {
          "expected_kind": {
            "const": "LORA_A"
          }
        }
      },
      "then": {
        "properties": {
          "expected": {
            "$ref": "../boundary/ActionExtraction.schema.json"
          },
          "reviewed_input": {
            "$ref": "../boundary/ActionExtractionInput.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "expected_kind"
        ],
        "properties": {
          "expected_kind": {
            "const": "LORA_B"
          }
        }
      },
      "then": {
        "properties": {
          "expected": {
            "$ref": "../boundary/ResponseText.schema.json"
          },
          "reviewed_input": {
            "$ref": "../boundary/ResponseRequest.schema.json"
          }
        }
      }
    }
  ],
  "$defs": {
    "Bounded": {
      "description": "검토자가 쓴 값(어떤 JSON 값이든). 문자열 길이 20000·개인정보 패턴·깊이 64 는 계약이 정한다: boundary_contracts.review_input.review_value_problems (INTERFACES I7 '검토 게시 값의 판정 기준', D117). 이 스키마에 같은 값의 사본을 두지 않는다."
    }
  }
}
