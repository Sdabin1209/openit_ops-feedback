{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeidResult",
  "description": "비식별 결과. trace는 계약 비식별 뷰를 지킨다.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "trace": {
      "$ref": "../boundary/OpsFeedbackDeidentifiedTrace.schema.json"
    },
    "stats": {
      "$ref": "DeidStats.schema.json"
    },
    "policy_fingerprint": {
      "$ref": "../boundary/_common.schema.json#/$defs/Hash"
    },
    "review_trace": {
      "$ref": "../boundary/OpsFeedbackReviewTrace.schema.json",
      "description": "정책 deid.review_utterance.keep=true일 때만 있다: 발화 두 칸만 원문인 검토 사본(reviewer 역할 전용 경로로만 나간다, ADR 0030)"
    }
  },
  "required": [
    "trace",
    "stats",
    "policy_fingerprint"
  ]
}
